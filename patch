@@ -0,0 +1,96 @@
+# Weakening options for x86 processors
+
+config WEAKEN_TASK_CHECK
+	bool "Check current task context"
+	default y
+	depends on X86
+
+config WEAKEN_SKIP_INST
+	bool "Skip instuction when fault (DANGEROUS)"
+	default n
+	depends on X86
+
+config WEAKEN_ALLOW_USR_ADDR
+	bool "Allow user address on copy_from_kernel"
+	default n
+	depends on X86
+
+config WEAKEN_ALLOW_VSYSCALL_ADDR
+	bool "Allow vsyscall address on copy_from_kernel"
+	default n
+	depends on X86
+
+config WEAKEN_SUPPRESS_CPA_CONFLICT
+	bool "Suppress logs when CPA conflicts"
+	default n
+	depends on X86
+
+config WEAKEN_STATIC_PROTECTION
+	bool "Enable static protection"
+	default y
+	depends on X86
+
+config WEAKEN_PAGE_RWX
+	bool "Make all pages RWX (DANGEROUS)"
+	default n
+	help
+		Make all pages RWX (__RW | __NX). 
+		This option will take too long time for re-compiling.
+	depends on X86
+
+config WEAKEN_PAGE_USR
+	bool "Make all pages like user page (DANGEROUS)"
+	default n
+	help
+		Treat all pages as the user page with __USR bit masking. 
+		You might want to disable SMAP, SMEP, and UMIP.
+	depends on X86
+
+config WEAKEN_STRICT_NMI_UACCESS
+	bool "Strict NMI uaccess"
+	default y
+	depends on X86
+
+config WEAKEN_MIGHT_FAULT
+	bool "Enable might_fault on usercopy"
+	default y
+
+config WEAKEN_STRICT_USERCOPY
+	bool "Check Masked user address"
+	default y
+
+config WEAKEN_RESTRICT_KEXEC
+	bool "Restrict kexec"
+	default y
+	help
+		Allow only superuser to use kexec when enabled.
+
+config WEAKEN_IGNORE_PANIC
+	bool "Ignore kernel panic and continue execution (DANGEROUS)"
+	default n
+
+config WEAKEN_OOPS_MSG
+	bool "Add cooked message when oops"
+	default y
+	help
+		prints "Hello, you are cooked. good luck." when oops
+
+config WEAKEN_ALWAYS_WRITABLE_PTE
+	bool "Allow to change PTE writable"
+	default n
+
+config WEAKEN_DISABLE_SMEP
+	bool "Disable SMEP"
+	default n
+	depends on X86
+
+config WEAKEN_DISABLE_SMAP
+	bool "Disable SMAP"
+	default n
+	depends on X86
+
+config WEAKEN_DISABLE_UMIP
+	bool "Disable UMIP"
+	default n
+	depends on X86
+
